# KiranaCrew environment template
# Copy this file to .env.local and fill in your credentials.
# Never commit real tokens, API keys, or personal filesystem paths.

GEMINI_API_KEY=
# OPENCLAW_PACKAGE_DIR=/absolute/path/to/openclaw
# OPENCLAW_PROTOCOL_MODULE=/absolute/path/to/openclaw/dist/gateway/protocol/index.js
OPENCLAW_GATEWAY_TOKEN=

TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

PORT=3000
HOST=127.0.0.1
AGENT_TOWN_DB_PATH=data/agent-town.sqlite

# Supported values: openclaw, nightshift, auggie
AGENT_PROVIDER=openclaw
AGENT_TOWN_SHARED_AGENT=main
AGENT_TOWN_OFFICE_LEAD_SEAT=seat-0

# Optional custom emergency-stop marker. The default is next to the SQLite DB.
# AGENT_TOWN_ESTOP_FILE=data/ESTOP

# Comma-separated HTTPS origins allowed only when an authenticated TLS proxy is used.
# AGENT_TOWN_PUBLIC_ORIGINS=https://kiranacrew.example.com

# -----------------------------------------------------------------------------
# OpenClaw provider (default core workflow)
# -----------------------------------------------------------------------------

GATEWAY_URL=ws://127.0.0.1:18789/
# GATEWAY_TOKEN is auto-read from ~/.openclaw/openclaw.json (gateway.auth.token)

# Optional protocol discovery overrides. Usually automatic discovery is sufficient.
# OPENCLAW_PACKAGE_DIR=/absolute/path/to/openclaw
# OPENCLAW_PROTOCOL_MODULE=/absolute/path/to/openclaw/dist/gateway/protocol/index.js

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Administrator-approved MCP servers (live ERPNext adapter + fixture for testing).
AGENT_TOWN_MCP_STDIO_ALLOWLIST=[{"command":"node","args":["lib/mcp/hvgerp-adapter-server.mjs"]},{"command":"node","args":["lib/mcp/fixture-erpnext-server.mjs"]}]
# AGENT_TOWN_MCP_HTTP_ALLOWLIST=[]
# Shared secret for the governed MCP proxy that OpenClaw calls (random, server-only).
# AGENT_TOWN_MCP_PROXY_SECRET=

# Launcher switch: run on OpenClaw without the specialist router and its discovery polling.
# AGENT_TOWN_EXECUTION_OPTIONS_DISABLED=1

# -----------------------------------------------------------------------------
# KiranaCrew (kirana store workforce)
# -----------------------------------------------------------------------------

# Store-owner PIN for approving purchase orders. Required for approve/reject.
# Use a strong PIN in production. 1234 is for local development only.
NAMMAOPS_OWNER_PIN=

# off (default, deterministic) | manager (one optional OpenClaw Manager turn per workflow).
NAMMAOPS_REASONING=off
# NAMMAOPS_REASONING_TIMEOUT_MS=900000

# Business-capability binding and workforce files.
# Live ERPNext (needs ERPNEXT_* values below):
NAMMAOPS_BINDING=config/nammaops/binding.hvgerp.json
NAMMAOPS_WORKFORCE=config/nammaops/workforce.json
# Synthetic test fixture (no ERPNext needed — development only):
# NAMMAOPS_BINDING=config/nammaops/binding.fixture.json
# NAMMAOPS_ALLOW_FIXTURE=1

# Fixed "today" for reproducible fixture runs (YYYY-MM-DD). Leave unset for live data.
# NAMMAOPS_TODAY=

# -----------------------------------------------------------------------------
# ERPNext (Frappe Cloud) through hvgerp-mcp — server-side only
# -----------------------------------------------------------------------------
# Never sent to the browser or the voice client.
# Use the dedicated nammaops.api user's API key and secret (ERPNext: User > API Access).

ERPNEXT_URL=https://your-site.m.frappe.cloud
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Reviewed MCP package version. Do not upgrade without reviewing the release.
HVGERP_MCP_VERSION=3.7.0

# -----------------------------------------------------------------------------
# Gnani voice: PRIMARY for all voice (Prisma STT + Timbre TTS). Gemini is the outage-only backup.
# -----------------------------------------------------------------------------
# The store mic, chat dictation and voice tasks all use these.
# Gemini is used only when Gnani is unreachable, times out or returns 5xx.
# Prisma STT endpoint: https://api.vachana.ai/stt/v3 (fixed, no override needed).
# Timbre TTS voices (timbre-v3.0): Avinash, Shivani, Lakshmi, Kalpana, Shubham,
#   Prakash, Devansh, Yashraj, Chetana, Vasudha, Harshad, Riyaa, Tarika.

GNANI_API_KEY=
AGENT_TOWN_STT_PROVIDER=gnani
AGENT_TOWN_STT_FALLBACK=gemini
AGENT_TOWN_TTS_PROVIDER=gnani
AGENT_TOWN_TTS_FALLBACK=gemini
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Avinash
GNANI_TTS_SAMPLE_RATE=44100
# Live-reply streaming transport: ws (realtime WebSocket, lowest latency) or sse (fallback).
GNANI_TTS_TRANSPORT=ws
# Default recognition/speech language when a request names none (en-IN, hi-IN, kn-IN, indic-auto).
GNANI_LANGUAGE=en-IN
