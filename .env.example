# KiranaCrew environment template
# Copy this file to .env.local and fill only the sections you use.
# Never commit real tokens, credentials, private URLs, or personal filesystem paths.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

PORT=3000
HOST=127.0.0.1
AGENT_TOWN_DB_PATH=data/agent-town.sqlite

# Supported values: openclaw, nightshift, auggie
AGENT_PROVIDER=openclaw
AGENT_TOWN_SHARED_AGENT=main
AGENT_TOWN_OFFICE_LEAD_SEAT=seat-0

# Optional custom emergency-stop marker. The default is next to the SQLite DB.
# AGENT_TOWN_ESTOP_FILE=data/ESTOP

# Comma-separated HTTPS origins allowed only when an authenticated TLS proxy is used.
# AGENT_TOWN_PUBLIC_ORIGINS=https://agent-town.example.com

# -----------------------------------------------------------------------------
# OpenClaw provider (default core workflow)
# -----------------------------------------------------------------------------

GATEWAY_URL=ws://127.0.0.1:18789/
GATEWAY_TOKEN=

# Optional protocol discovery overrides. Usually automatic discovery is sufficient.
# OPENCLAW_PACKAGE_DIR=/absolute/path/to/openclaw
# OPENCLAW_PROTOCOL_MODULE=/absolute/path/to/openclaw/dist/gateway/protocol/index.js

# Remote gateways must use wss:// and require this explicit opt-in.
# ALLOW_REMOTE_GATEWAY=true

# -----------------------------------------------------------------------------
# Meterless Nightshift provider
# -----------------------------------------------------------------------------

NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_MODEL=meterless/auto

# -----------------------------------------------------------------------------
# Meterless H-MEM decision memory
# -----------------------------------------------------------------------------

# H-MEM runs inside KiranaCrew and persists through AGENT_TOWN_DB_PATH. It is a
# local reference implementation, not a hosted API, so there is no HMEM_API_KEY.
# Configure the optional embeddings section below only if semantic ranking is
# required; H-MEM continues to work with lexical ranking when it is omitted.

# -----------------------------------------------------------------------------
# NVIDIA / Nemotron (adapter-ready)
# -----------------------------------------------------------------------------

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# NGC_API_KEY is separate: it is used to pull/download a self-hosted NIM image
# and model artifacts. It is not the hosted inference credential above.
# NGC_API_KEY=

# -----------------------------------------------------------------------------
# SpaceXAI / Grok (not active KiranaCrew provider yet) (optional)
# -----------------------------------------------------------------------------

# SpaceXAI's API uses XAI_API_KEY and an OpenAI-compatible endpoint.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# -----------------------------------------------------------------------------
# Reviewed specialist configuration
# -----------------------------------------------------------------------------

# JSON array of {"manifestId","seatId","sessionKey"?} bindings.
AGENT_TOWN_SPECIALIST_GRANTS=[]

# JSON object keyed by reviewed manifest ID. Used only for supported OpenClaw
# provisioning profiles: {"manifest-id":{"seatId","name","workspace","label"?}}.
AGENT_TOWN_SPECIALIST_PROFILES={}

# Optional secondary OpenClaw runtimes. Tokens are referenced by environment
# variable name; never place a literal token inside this JSON.
AGENT_TOWN_EXECUTION_OPTIONS=[]
AGENT_TOWN_EXECUTION_PREFERENCE=[]

# -----------------------------------------------------------------------------
# Inventory evidence mode
# -----------------------------------------------------------------------------

# Leave unset for no inventory reader. Supported values: synthetic, zetaris.
# AGENT_TOWN_INVENTORY_MODE=synthetic

# Safe local demonstration fixtures:
# AGENT_TOWN_INVENTORY_SYNTHETIC_CASE=complete
# AGENT_TOWN_INVENTORY_SYNTHETIC_PROFILE=sku17-bin-a

# -----------------------------------------------------------------------------
# Zetaris evidence source
# -----------------------------------------------------------------------------

# Enable only after all endpoints and credentials match the installed contract.
# For local HTTP, all endpoints must be loopback and ALLOW_LOOPBACK_HTTP must be 1.
ZETARIS_OPEN_URL=http://127.0.0.1:8888/api/v1.0/query/sql/start
ZETARIS_PAGE_URL=http://127.0.0.1:8888/api/v1.0/query/sql/page
ZETARIS_CLOSE_URL=http://127.0.0.1:8888/api/v1.0/query/sql/close/{queryToken}
ZETARIS_PAGE_METHOD=GET
ZETARIS_CLOSE_METHOD=DELETE
ZETARIS_BEARER_TOKEN=
ZETARIS_ORG_ID=
ZETARIS_ROWS_KEY=records
ZETARIS_QUERY_TOKEN_KEY=queryToken
ZETARIS_PROBE_SELECT=SELECT 1 AS readiness_check
ZETARIS_ALLOW_LOOPBACK_HTTP=1

# Bounded timeout tuning in milliseconds.
ZETARIS_OPEN_TIMEOUT_MS=10000
ZETARIS_OPEN_MAX_TIMEOUT_MS=120000
ZETARIS_PAGE_TIMEOUT_MS=10000
ZETARIS_CLEANUP_TIMEOUT_MS=10000
ZETARIS_QUERY_TIMINGS_PATH=data/zetaris-query-timings.json

# -----------------------------------------------------------------------------
# Web evidence (Tavily)
# -----------------------------------------------------------------------------

TAVILY_API_KEY=
# Alternatively, use Tavily's supported rate-limited keyless mode.
# TAVILY_KEYLESS=1

# -----------------------------------------------------------------------------
# Optional Gemini Live voice
# -----------------------------------------------------------------------------

GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Optional OpenAI-compatible embeddings for memory ranking
# -----------------------------------------------------------------------------

# Recall remains lexical when these settings are omitted.
# AGENT_TOWN_EMBEDDINGS_URL=http://127.0.0.1:11434/v1
# AGENT_TOWN_EMBEDDINGS_MODEL=your-embedding-model
# AGENT_TOWN_EMBEDDINGS_KEY_ENV=EMBEDDINGS_API_KEY
# EMBEDDINGS_API_KEY=

# -----------------------------------------------------------------------------
# Phase A–C: agents, speech-to-text, Developer Mode and governed MCP
# -----------------------------------------------------------------------------

# REST voice tasks: fixture | gemini | gnani. Unset means POST /api/tasks/voice returns 503.
# AGENT_TOWN_STT_PROVIDER=
# AGENT_TOWN_STT_FIXTURE_TRANSCRIPT=
# Optional fallback (e.g. gemini), used only when the primary has an outage (5xx/timeout),
# never when it rejects the request. The task records which provider produced the transcript.
# AGENT_TOWN_STT_FALLBACK=

# Spoken replies: fixture | gemini | gnani. Unset means POST /api/tasks/voice/speak returns 503.
# AGENT_TOWN_TTS_PROVIDER=
# AGENT_TOWN_TTS_FALLBACK=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# OpenClaw seat used for Developer Mode configuration generation.
# AGENT_TOWN_DEVELOPER_GENERATION_SEAT=oc-planner

# Administrator-approved MCP servers. Exact stdio command lines and https origins only.
# Fixture only:
# AGENT_TOWN_MCP_STDIO_ALLOWLIST=[{"command":"node","args":["lib/mcp/fixture-erpnext-server.mjs"]}]
# Live ERPNext (read-only adapter over the pinned hvgerp-mcp), plus the fixture if you still want it:
# AGENT_TOWN_MCP_STDIO_ALLOWLIST=[{"command":"node","args":["lib/mcp/fixture-erpnext-server.mjs"]},{"command":"node","args":["lib/mcp/hvgerp-adapter-server.mjs"]}]
# AGENT_TOWN_MCP_HTTP_ALLOWLIST=[]
# Shared secret for the governed MCP proxy that OpenClaw calls (random, server-only).
# AGENT_TOWN_MCP_PROXY_SECRET=

# Launcher switch: run on OpenClaw without the specialist router and its discovery polling.
# AGENT_TOWN_EXECUTION_OPTIONS_DISABLED=1

# -----------------------------------------------------------------------------
# KiranaCrew (kirana store workforce)
# -----------------------------------------------------------------------------

# Store-owner PIN for approving purchase orders. Unset means the starter PIN 1234. The owner can
# change it in Settings; a PIN set there (stored as a salted hash) takes precedence over this value.
NAMMAOPS_OWNER_PIN=

# off (default, deterministic) | manager (one optional OpenClaw Manager turn per workflow).
NAMMAOPS_REASONING=off
# NAMMAOPS_REASONING_TIMEOUT_MS=900000

# Business-capability binding and workforce files. The fixture binding is the default.
# NAMMAOPS_BINDING=config/nammaops/binding.fixture.json
# Live, READ-ONLY ERPNext (needs the ERPNEXT_* values below and the allowlist entry above):
# NAMMAOPS_BINDING=config/nammaops/binding.hvgerp.json
# NAMMAOPS_WORKFORCE=config/nammaops/workforce.json

# Fixed "today" for reproducible fixture runs (YYYY-MM-DD). Leave unset for live data.
# NAMMAOPS_TODAY=

# -----------------------------------------------------------------------------
# ERPNext (Frappe Cloud) through hvgerp-mcp — server-side only
# -----------------------------------------------------------------------------
# Keep these in .env.erpnext.local (git-ignored). Use the dedicated nammaops.api user's
# API key and secret (ERPNext: User > API Access). Never Administrator credentials.
# They are never sent to the browser or the voice client.

ERPNEXT_URL=https://your-site.m.frappe.cloud
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Reviewed MCP package version. Do not upgrade without reviewing the release.
HVGERP_MCP_VERSION=3.7.0

# -----------------------------------------------------------------------------
# Gnani voice: PRIMARY for all voice (Prisma STT + Timbre TTS). Gemini is the outage-only backup.
# -----------------------------------------------------------------------------
# The store mic, chat dictation and voice tasks all use these. Gemini is used only when Gnani
# is unreachable, times out or returns 5xx; a rejected request (4xx) is reported, not retried.
# Prisma STT: https://api.vachana.ai/stt/v3 (fixed). Timbre TTS returns raw 24 kHz PCM, which
# the server wraps as WAV. Models: timbre-v2.5, timbre-v3.0. v3.0 voices: Avinash, Shivani,
# Lakshmi, Kalpana, Shubham, Prakash, Devansh, Yashraj, Chetana, Vasudha, Harshad, Riyaa, Tarika.

# GNANI_API_KEY=
# AGENT_TOWN_STT_PROVIDER=gnani
# AGENT_TOWN_STT_FALLBACK=gemini
# AGENT_TOWN_TTS_PROVIDER=gnani
# AGENT_TOWN_TTS_FALLBACK=gemini
# GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
# GNANI_TTS_MODEL=timbre-v3.0
# GNANI_TTS_VOICE=Avinash
# Default language when a request names none (en-IN, hi-IN, kn-IN). The workflow parser
# understands English, so keep en-IN until Kannada/Hindi intent support lands.
# GNANI_LANGUAGE=en-IN
