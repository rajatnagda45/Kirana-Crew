{
  "_note": "LIVE ERPNext binding (read-only). Tools are served by lib/mcp/hvgerp-adapter-server.mjs, which calls the pinned @hvgllc/hvgerp-mcp@3.7.0 and exposes only the business read tools below (23 reads). The two write capabilities (erp.po.create_draft, erp.po.submit) have tool:null and a disabled reason on purpose: live writes stay off. Select with NAMMAOPS_BINDING=config/nammaops/binding.hvgerp.json.",
  "shape": "hvgerp",
  "data_label": "Live ERPNext Cloud (demo store; records marked NAMMAOPS-SEED are synthetic demo data)",
  "server": {
    "server_id": "erpnext-live",
    "name": "ERPNext Cloud (read-only adapter over hvgerp-mcp 3.7.0)",
    "description": "Narrow read-only adapter. Credentials come from ERPNEXT_URL, ERPNEXT_API_KEY and ERPNEXT_API_SECRET in the server environment only.",
    "transport": "stdio",
    "connection": {
      "command": "node",
      "args": ["lib/mcp/hvgerp-adapter-server.mjs"]
    },
    "authentication_refs": ["ERPNEXT_URL", "ERPNEXT_API_KEY", "ERPNEXT_API_SECRET"],
    "connect_timeout_ms": 30000,
    "request_timeout_ms": 120000
  },
  "capabilities": {
    "erp.items.list": {
      "tool": "list_items",
      "risk": "READ"
    },
    "erp.stock.balance": {
      "tool": "get_stock_balance",
      "risk": "READ"
    },
    "erp.warehouses.list": {
      "tool": "list_warehouses",
      "risk": "READ"
    },
    "erp.stock.ledger": {
      "tool": "get_stock_ledger",
      "risk": "READ"
    },
    "erp.suppliers.list": {
      "tool": "list_suppliers",
      "risk": "READ"
    },
    "erp.supplier_quotations.list": {
      "tool": "list_supplier_quotations",
      "risk": "READ"
    },
    "erp.item_prices.get": {
      "tool": "get_item_prices",
      "risk": "READ"
    },
    "erp.po.create_draft": {
      "tool": null,
      "risk": "WRITE",
      "disabled": "Live writes are disabled pending a separate security review; a PIN or approval cannot enable them."
    },
    "erp.po.get": {
      "tool": "get_purchase_order",
      "risk": "READ"
    },
    "erp.po.submit": {
      "tool": null,
      "risk": "EXTERNAL_ACTION",
      "disabled": "Live writes are disabled pending a separate security review; a PIN or approval cannot enable them."
    },
    "erp.sales_invoices.list": {
      "tool": "list_sales_invoices",
      "risk": "READ"
    },
    "erp.pos_invoices.list": {
      "tool": "list_pos_invoices",
      "risk": "READ"
    },
    "erp.customers.list": {
      "tool": "list_customers",
      "risk": "READ"
    },
    "erp.pnl": {
      "tool": "get_profit_and_loss",
      "risk": "READ"
    },
    "erp.gl": {
      "tool": "get_general_ledger",
      "risk": "READ"
    },
    "erp.purchase_invoices.list": {
      "tool": "list_purchase_invoices",
      "risk": "READ"
    },
    "erp.payments.summary": {
      "tool": "get_payment_summary",
      "risk": "READ"
    },
    "erp.sales.history": {
      "tool": "list_sales_lines",
      "risk": "READ"
    },
    "erp.stock.movements": {
      "tool": "list_stock_ledger",
      "risk": "READ"
    },
    "erp.po.open": {
      "tool": "list_open_purchase_orders",
      "risk": "READ"
    },
    "erp.items.valuation": {
      "tool": "get_item_valuation",
      "risk": "READ"
    },
    "erp.batches.list": {
      "tool": "list_batches",
      "risk": "READ"
    },
    "erp.receivables.aging": {
      "tool": "list_receivables",
      "risk": "READ"
    },
    "erp.payables.aging": {
      "tool": "list_payables",
      "risk": "READ"
    },
    "erp.gst.summary": {
      "tool": "list_gst_lines",
      "risk": "READ"
    }
  }
